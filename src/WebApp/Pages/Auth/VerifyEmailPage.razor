@page "/verify-email"
@layout EmptyLayout
@attribute [AllowAnonymous]
@implements IDisposable

@inject IApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Verificar e-mail — WeeklyUp</PageTitle>

<MudPaper Class="pa-8 ma-auto" MaxWidth="400px" Elevation="3">
    <MudStack Spacing="4" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h5" Color="Color.Primary"><b>WeeklyUp</b></MudText>

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.body1" Align="Align.Center">Verificando seu e-mail...</MudText>
        }
        else if (_success)
        {
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
            <MudText Typo="Typo.h6" Align="Align.Center">E-mail verificado!</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                Sua conta está ativa. Você será redirecionado automaticamente.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">
                Ir para o Dashboard
            </MudButton>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
            <MudText Typo="Typo.h6" Align="Align.Center">Link inválido ou expirado</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                O link de verificação expirou ou é inválido. Faça login e solicite um novo e-mail de verificação.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login">
                Ir para o Login
            </MudButton>
        }
    </MudStack>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private bool _loading = true;
    private bool _success;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _loading = false;
            return;
        }

        try
        {
            _success = await ApiClient.VerifyEmailAsync(Token);
        }
        catch (HttpRequestException)
        {
            _success = false;
        }
        finally
        {
            _loading = false;
        }

        if (_success)
        {
            try
            {
                await Task.Delay(2500, _cts.Token);
                Navigation.NavigateTo("/");
            }
            catch (OperationCanceledException) { /* navegado antes do redirect */ }
        }
    }

    public void Dispose() => _cts.Cancel();
}
