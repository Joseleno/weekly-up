@attribute [AllowAnonymous]

<MudPaper Elevation="0" Class="hero-section py-16 px-4">
    <MudContainer MaxWidth="MaxWidth.Medium">
        <MudStack AlignItems="AlignItems.Center" Spacing="6">
            <MudText Typo="Typo.h3" Align="Align.Center" Color="Color.Primary">
                <b>WeeklyUp</b>
            </MudText>

            <MudText Typo="Typo.h4" Align="Align.Center" Style="max-width:700px; line-height:1.3">
                Toda segunda-feira, o resumo completo do seu negócio no e-mail
            </MudText>

            <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Secondary"
                     Style="max-width:560px; font-weight:400">
                Conecte suas ferramentas, relaxe. O WeeklyUp coleta, analisa e envia um relatório
                inteligente com insights de IA — sem você precisar fazer nada.
            </MudText>

            <MudStack Row="true" Spacing="3" Justify="Justify.Center" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Href="/register"
                           Style="min-width:200px">
                    Começar grátis
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Href="/login"
                           Style="min-width:160px">
                    Entrar
                </MudButton>
            </MudStack>

            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Sem cartão de crédito · Plano grátis para sempre · Cancele quando quiser
            </MudText>

            <MudStack Row="true" Spacing="6" Justify="Justify.Center" Wrap="Wrap.Wrap" Class="mt-4">
                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.h4" Color="Color.Primary"><b>2 min</b></MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">para configurar</MudText>
                </MudStack>
                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.h4" Color="Color.Primary"><b>100%</b></MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">automático</MudText>
                </MudStack>
                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.h4" Color="Color.Primary"><b>IA</b></MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">insights semanais</MudText>
                </MudStack>
            </MudStack>
        </MudStack>
    </MudContainer>
</MudPaper>
