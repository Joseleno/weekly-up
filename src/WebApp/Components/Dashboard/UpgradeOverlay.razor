@* Overlay de upgrade para funcionalidades Pro *@

<div style="position: relative; overflow: hidden; border-radius: 4px;">
    <div style="filter: blur(4px); pointer-events: none; user-select: none;">
        @ChildContent
    </div>
    <div style="position: absolute; inset: 0; display: flex; flex-direction: column;
                align-items: center; justify-content: center; gap: 12px;
                background: rgba(0,0,0,0.35); border-radius: 4px;">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Large" />
        <MudText Typo="Typo.subtitle2" Color="Color.Surface" Align="Align.Center">
            @Message
        </MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Href="/billing">
            Ver planos
        </MudButton>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public string Message { get; set; } = "Disponível no plano Pro";
}
