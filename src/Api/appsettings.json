{
  "ConnectionStrings": {
    "Database": "",
    "Redis": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "weeklyup-api",
    "Audience": "weeklyup-clients",
    "ExpirationMinutes": 60
  },
  "AesEncryption": {
    "Key": ""
  },
  "Resend": {
    "ApiKey": "",
    "FromEmail": "noreply@weeklyup.app",
    "FromName": "WeeklyUp"
  },
  "Claude": {
    "ApiKey": "",
    "Model": "claude-sonnet-4-6",
    "MaxTokens": 1024
  },
  "EvolutionApi": {
    "BaseUrl": "http://localhost:8080",
    "ApiKey": "",
    "Instance": "weeklyup"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
