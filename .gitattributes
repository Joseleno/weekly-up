# Normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declare text files
*.cs    text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.slnx  text eol=lf
*.sln   text eol=lf
*.sh    text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.pdf   binary
